# Local Ollama is the default: free, offline, no API key.
# Change to cloud to use a hosted provider (Gemini / Groq / OpenRouter).
DEFAULT_PROVIDER=ollama

# 8 GB Mac: qwen3:4b   16 GB Mac: qwen3:8b   faster demo: qwen3:0.6b
OLLAMA_MODEL=qwen3:4b

# Cloud mode: base URL must be OpenAI-compatible.
# Gemini: https://generativelanguage.googleapis.com/v1beta/openai
# Groq:   https://api.groq.com/openai/v1
# OpenRouter: https://openrouter.ai/api/v1
CLOUD_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CLOUD_MODEL=gemini-2.5-flash
# CLOUD_API_KEY=your-key-here

# RUST_LOG=hearme=info
